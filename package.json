{
  "name": "minimax-m3-deepsearchqa-skill-eval",
  "type": "module",
  "private": true,
  "scripts": {
    "scaffold": "bun run scripts/scaffold.ts",
    "generate": "bun run scripts/generate.ts",
    "grade": "bun run scripts/grade.ts",
